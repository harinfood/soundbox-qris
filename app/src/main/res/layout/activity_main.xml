<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <Button
        android:id="@+id/btnIzin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Buka Izin Akses Notifikasi" />

    <Button
        android:id="@+id/btnTes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tes Suara" />

    <Button
        android:id="@+id/btnPilihMp3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pilih File MP3 Notifikasi" />

    <TextView
        android:id="@+id/txtSuara"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Suara: nada notifikasi HP (default)" />

    <Button
        android:id="@+id/btnResetMp3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pakai Nada Notifikasi HP" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Aplikasi yang dipantau (kosong = semua aplikasi)"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/listAplikasi"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
